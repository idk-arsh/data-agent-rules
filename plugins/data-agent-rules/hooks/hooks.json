{
  "description": "Load the data agent rules at session start; ask before destructive SQL, before raw reads of personal-looking columns, and before BigQuery queries over the scan budget",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cat \"${CLAUDE_PLUGIN_ROOT}/rules.md\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/sql_guard.py\" 2>/dev/null || python \"${CLAUDE_PLUGIN_ROOT}/hooks/sql_guard.py\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/pii_guard.py\" 2>/dev/null || python \"${CLAUDE_PLUGIN_ROOT}/hooks/pii_guard.py\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/cost_guard.py\" 2>/dev/null || python \"${CLAUDE_PLUGIN_ROOT}/hooks/cost_guard.py\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
